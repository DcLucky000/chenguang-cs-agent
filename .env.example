# 有密钥时，ask / chat / serve 默认把「下一步用哪个工具、要不要继续」交给 DeepSeek。
# 模型 id 默认 deepseek-flash，即 DeepSeek-V4.1-Flash-1017（用户所称 DeepSeek v4.1Flash1017）。
# 评测命令始终走离线逐步决策，不读取这个密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 演示级。同一 session 每分钟最多这么多次，计数只在当前进程内存里。
CHENGUANG_RATE_LIMIT=30
# 顾客原话超过这个长度就拒绝，不调用工具。
CHENGUANG_MAX_INPUT_CHARS=1000
# Agent 循环上限。到了就停，并按已有观察给一版受护栏约束的回复。
CHENGUANG_MAX_ITERATIONS=8
# 单轮墙钟秒数。超时后停止再向模型或工具要下一步。
CHENGUANG_TURN_TIMEOUT_S=25
# 可选。不设时写到仓库下的 runs/。
# CHENGUANG_RUNS_DIR=
